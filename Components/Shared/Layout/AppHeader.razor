<div class="app-header">
    <div class="header-content">
        <!-- 3-Line Hamburger Menu -->
        <button class="hamburger-menu-btn" @onclick="HandleMenuClick">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
            </svg>
        </button>

        <div class="header-titles">
            <h2>@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="subtitle">@Subtitle</p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Subtitle { get; set; } = "";

    [Parameter]
    public EventCallback OnMenuClicked { get; set; }

    private async Task HandleMenuClick()
    {
        if (OnMenuClicked.HasDelegate)
        {
            await OnMenuClicked.InvokeAsync();
        }
    }
}