@inject nApps.Futs.Mobile.Shared.Navigation.IBackNavigationService BackNavigationService

<button class="app-back-button" @onclick="HandleBack" aria-label="Go Back">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
        <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
    </svg>
</button>

<style>
    .app-back-button {
        background: transparent;
        border: none;
        color: var(--text-primary); /* Automatically handles Light/Dark theme */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        margin: 0;
        margin-right: 12px; /* Gives perfect spacing between the arrow and the page title */
        cursor: pointer;
        transition: opacity 0.2s ease, transform 0.1s ease;
    }

        .app-back-button:active {
            opacity: 0.6;
            transform: scale(0.95); /* Soft tap feedback */
        }
</style>

@code {
    async Task HandleBack()
    {
        if (BackNavigationService != null)
        {
            var handled = await BackNavigationService.TryGoBackAsync();
            if (!handled)
            {
                // optionally show a confirmation or rely on hardware flow
                if (Microsoft.Maui.Devices.DeviceInfo.Platform != Microsoft.Maui.Devices.DevicePlatform.Android)
                {
                    await Microsoft.Maui.Controls.Application.Current.MainPage.DisplayAlert("Exit", "You are at the root. Use system back to exit.", "OK");
                }
            }
        }
    }
}