@page "/customer/edit"

@inject EditProfileViewModel ViewModel
@inject NavigationManager Navigation

<PageContainer>

    <AppHeader Title="Edit Profile" />

    @if (ViewModel.IsBusy)
    {
        <p>Loading...</p>
    }
    else
    {
        <ProfileAvatar ImageUrl="@ViewModel.Customer?.ProfilePhotoUrl"
                       ShowEditButton="true"
                       CanDelete="@(!string.IsNullOrWhiteSpace(ViewModel.Customer?.ProfilePhotoUrl))"
                       OnChangePhoto="UploadPhoto"
                       OnDeletePhoto="DeletePhoto" />

        <div class="form-container">
            <AppTextBox Label="Mobile Number"
                        Value="@ViewModel.Customer?.MobileNumber"
                        Disabled="true" />

            <AppTextBox Label="Full Name"
                        @bind-Value="ViewModel.Model.FullName" />

            <AppTextBox Label="Email"
                        @bind-Value="ViewModel.Model.Email" />

            <AppDatePicker Label="Date of Birth"
                           Value="ViewModel.Model.DateOfBirth"
                           ValueChanged="@(value => ViewModel.Model.DateOfBirth = value)" />

            <AppSelect TValue="Gender"
                       Label="Gender"
                       Value="ViewModel.Model.Gender"
                       ValueChanged="@(value => ViewModel.Model.Gender = value)"
                       Items="ViewModel.GenderOptions" />

            @* <AppTextBox Label="Preferred Language"
                        @bind-Value="ViewModel.Model.PreferredLanguage" /> *@

            <div class="mt-4">
                <AppButton Text="Save"
                           OnClick="SaveAsync" />
            </div>

        </div>
    }

</PageContainer>

@code
{
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += ViewModelChanged;

        await ViewModel.LoadAsync();
    }

    private async Task ChangePhoto()
    {
        await ViewModel.UploadPhotoAsync();
    }

    private async Task SaveAsync()
    {
        await ViewModel.SaveAsync();

        Navigation.NavigateTo("/customer/profile");
    }

    private async void ViewModelChanged(
        object? sender,
        System.ComponentModel.PropertyChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task UploadPhoto()
    {
        await ViewModel.UploadPhotoAsync();
    }

    private async Task DeletePhoto()
    {
        await ViewModel.DeletePhotoAsync();
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= ViewModelChanged;
    }
}