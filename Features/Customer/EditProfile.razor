@page "/customer/edit"

@inject EditProfileViewModel ViewModel
@inject NavigationManager Navigation

<PageContainer>

    <AppHeader Title="Edit Profile" ShowBackButton="true" />

    @if (ViewModel.IsBusy && ViewModel.Customer == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <!-- Key forces a refresh, GetImageUrl bypasses browser caching -->
        <ProfileAvatar @key="_imageTimestamp"
                       ImageUrl="@GetImageUrl(ViewModel.Customer?.ProfilePhotoUrl)"
                       OnAvatarClicked="HandleAvatarClick" />

        <div class="app-card edit-profile-card">
            <AppTextBox Label="Mobile Number"
                        Value="@ViewModel.Customer?.MobileNumber"
                        Disabled="true" />

            <AppTextBox Label="Full Name"
                        @bind-Value="ViewModel.Model.FullName" />

            <AppTextBox Label="Email"
                        @bind-Value="ViewModel.Model.Email" />

            <AppDatePicker Label="Date of Birth"
                           Value="ViewModel.Model.DateOfBirth"
                           ValueChanged="@(value => ViewModel.Model.DateOfBirth = value)" />

            <AppSelect TValue="nApps.Futs.Mobile.Shared.Constants.Gender"
                       Label="Gender"
                       Value="ViewModel.Model.Gender"
                       ValueChanged="@(value => ViewModel.Model.Gender = value)"
                       Items="ViewModel.GenderOptions" />

            <div class="mt-4">
                <AppButton Text="Save"
                           OnClick="SaveAsync" />
            </div>
        </div>
    }

    <!-- WhatsApp Style Profile Photo Bottom Sheet -->
    @if (_isPhotoSheetVisible)
    {
        <div class="photo-sheet-overlay" @onclick="ClosePhotoSheet">
            <div class="photo-sheet" @onclick:stopPropagation="true">
                <div class="sheet-drag-handle"></div>

                <div class="sheet-header">
                    <!-- Close X -->
                    <button class="sheet-icon-btn" @onclick="ClosePhotoSheet" aria-label="Cancel">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                        </svg>
                    </button>

                    <h3>Profile picture</h3>

                    <!-- Delete Trash -->
                    <button class="sheet-icon-btn" @onclick="HandleDeleteClick" aria-label="Remove photo">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                            <path d="M15 4V3H9v1H4v2h1v13c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V6h1V4h-5zm2 15H7V6h10v13zM9 8h2v9H9V8zm4 0h2v9h-2V8z" />
                        </svg>
                    </button>
                </div>

                <div class="sheet-action-item" @onclick="HandleCameraGalleryClick">
                    <div class="sheet-action-icon">
                        <!-- Camera Icon -->
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                            <circle cx="12" cy="12" r="3.2" />
                            <path d="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z" />
                        </svg>
                    </div>
                    <span class="sheet-action-text">Camera</span>
                </div>

                <div class="sheet-action-item" @onclick="HandleCameraGalleryClick">
                    <div class="sheet-action-icon">
                        <!-- Gallery Icon -->
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                            <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                        </svg>
                    </div>
                    <span class="sheet-action-text">Gallery</span>
                </div>
            </div>
        </div>
    }

</PageContainer>

<style>
    /* Profile Edit Card */
    .edit-profile-card {
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        border: none;
        margin: 0 16px 24px 16px;
        background-color: var(--bg-card);
        padding: 24px 20px;
    }

    /* Bottom Sheet Overlay */
    .photo-sheet-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 2000;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        animation: fadeIn 0.2s ease-out;
    }

    /* Bottom Sheet Container */
    .photo-sheet {
        background-color: var(--bg-card);
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        padding: 12px 0 24px 0;
        color: var(--text-primary);
        box-shadow: 0 -4px 24px rgba(0,0,0,0.2);
        animation: slideUp 0.3s cubic-bezier(0.1, 0.9, 0.2, 1);
        padding-bottom: env(safe-area-inset-bottom, 24px); /* Adapts to iOS bottom bar */
    }

    .sheet-drag-handle {
        width: 36px;
        height: 4px;
        background-color: var(--border-subtle, #555);
        border-radius: 2px;
        margin: 0 auto 16px auto;
    }

    .sheet-header {
        display: flex;
        align-items: center;
        padding: 0 16px;
        margin-bottom: 12px;
    }

        .sheet-header h3 {
            flex: 1;
            margin: 0 0 0 16px;
            font-size: 18px;
            font-weight: 600;
            text-align: left;
        }

    .sheet-icon-btn {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        padding: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border-radius: 50%;
        transition: background-color 0.2s;
    }

        .sheet-icon-btn:active {
            background-color: rgba(128,128,128,0.1);
        }

    .sheet-action-item {
        display: flex;
        align-items: center;
        padding: 16px 24px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .sheet-action-item:active {
            background-color: rgba(128,128,128,0.1);
        }

    .sheet-action-icon {
        color: var(--text-secondary);
        margin-right: 20px;
        display: flex;
    }

    .sheet-action-text {
        font-size: 16px;
        font-weight: 500;
    }

    /* Animations */
    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
    @@keyframes slideUp {
        from {
            transform: translateY(100%);
        }

        to {
            transform: translateY(0);
        }
    }
</style>

@code
{
    private long _imageTimestamp = DateTime.UtcNow.Ticks;
    private bool _isPhotoSheetVisible = false;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += ViewModelChanged;
        await ViewModel.LoadAsync();
    }

    private async Task SaveAsync()
    {
        await ViewModel.SaveAsync();
        Navigation.NavigateTo("/customer/profile");
    }

    // Opens the WhatsApp style bottom sheet
    private void HandleAvatarClick()
    {
        _isPhotoSheetVisible = true;
    }

    private void ClosePhotoSheet()
    {
        _isPhotoSheetVisible = false;
    }

    // Handles picking a photo (maps both Camera and Gallery to your ViewModel)
    private async Task HandleCameraGalleryClick()
    {
        _isPhotoSheetVisible = false;

        await ViewModel.UploadPhotoAsync();
        await Task.Delay(500); // Give backend time to save the file before fetching

        _imageTimestamp = DateTime.UtcNow.Ticks;
        await InvokeAsync(StateHasChanged);
    }

    // Handles deleting the photo
    private async Task HandleDeleteClick()
    {
        _isPhotoSheetVisible = false;

        // Instantly clear the image on the UI side just in case
        if (ViewModel.Customer != null)
        {
            ViewModel.Customer.ProfilePhotoUrl = null;
        }

        _imageTimestamp = DateTime.UtcNow.Ticks;
        await InvokeAsync(StateHasChanged);

        await ViewModel.DeletePhotoAsync();
    }

    private string? GetImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;

        var separator = url.Contains("?") ? "&" : "?";
        return $"{url}{separator}t={_imageTimestamp}";
    }

    private async void ViewModelChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= ViewModelChanged;
    }
}