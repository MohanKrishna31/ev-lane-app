@page "/customer/profile"


@inject CustomerViewModel ViewModel
@inject NavigationManager Navigation

<PageContainer>

    <!-- AppHeader keeps your top navigation bar consistent -->
    <AppHeader Title="Profile" />

    @if (ViewModel.IsBusy)
    {
        <div class="profile-loading">
            <p>Loading profile...</p>
        </div>
    }
    else if (ViewModel.Customer is null)
    {
        <div class="profile-error">
            <p>Unable to load profile.</p>
            <AppButton Text="Retry" OnClick="LoadProfile" />
            <AppButton Text="Logout" OnClick="Logout" />
        </div>
    }
    else
    {
        <div class="profile-page-wrapper">

            <!-- WhatsApp Style Header (Avatar, Name, Edit Button) -->
            <div class="profile-header-section">
                <!-- Set ShowEditButton to false because we add the stylized text 'Edit' below the name -->
                <ProfileAvatar ImageUrl="@ViewModel.Customer?.ProfilePhotoUrl"
                    ShowEditButton="false"
                    OnChangePhoto="ChangePhoto" />

                <h2 class="profile-main-name">
                    @(string.IsNullOrWhiteSpace(ViewModel.Customer?.FullName) ? "Add your name" : ViewModel.Customer?.FullName)
                </h2>

                <button class="profile-edit-text-btn" @onclick="EditProfile">Edit</button>
            </div>

            <!-- WhatsApp Style List -->
            <div class="profile-list-container">

                <!-- Full Name Item -->
                <div class="profile-list-item">
                    <div class="profile-icon">
                        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="currentColor" /></svg>
                    </div>
                    <div class="profile-text-content">
                        <span class="profile-label">Name</span>
                        <span class="profile-value">@ViewModel.Customer!.FullName</span>
                    </div>
                </div>

                <!-- Mobile Item -->
                <div class="profile-list-item">
                    <div class="profile-icon">
                        <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" fill="currentColor" /></svg>
                    </div>
                    <div class="profile-text-content">
                        <span class="profile-label">Phone</span>
                        <span class="profile-value">@ViewModel.Customer!.MobileNumber</span>
                    </div>
                </div>

                <!-- Email Item -->
                <div class="profile-list-item">
                    <div class="profile-icon">
                        <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" fill="currentColor" /></svg>
                    </div>
                    <div class="profile-text-content">
                        <span class="profile-label">Email</span>
                        <span class="profile-value">@(string.IsNullOrEmpty(ViewModel.Customer!.Email) ? "Not provided" : ViewModel.Customer!.Email)</span>
                    </div>
                </div>

                <!-- Wallet Item -->
                <div class="profile-list-item">
                    <div class="profile-icon">
                        <svg viewBox="0 0 24 24"><path d="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="currentColor" /></svg>
                    </div>
                    <div class="profile-text-content">
                        <span class="profile-label">Wallet Balance</span>
                        <span class="profile-value">₹ @ViewModel.Customer!.WalletBalance</span>
                    </div>
                </div>

               @*  <!-- Language Item -->
                <div class="profile-list-item">
                    <div class="profile-icon">
                        <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z" fill="currentColor" /></svg>
                    </div>
                    <div class="profile-text-content">
                        <span class="profile-label">App language</span>
                        <span class="profile-value">@ViewModel.Customer!.PreferredLanguage</span>
                    </div>
                </div> *@

                <!-- Info (DOB/Gender/Referral) -->
                <div class="profile-list-item">
                    <div class="profile-icon">
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" fill="currentColor" /></svg>
                    </div>
                    <div class="profile-text-content">
                        <span class="profile-label">Additional Info</span>
                        <span class="profile-value">Born @(ViewModel.Customer!.DateOfBirth?.ToString("dd MMM yyyy") ?? "N/A") • @ViewModel.Customer!.Gender</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons Container (Refresh & Logout) -->
            <div class="profile-actions-container">
                <div class="profile-list-item clickable" @onclick="LoadProfile">
                    <div class="profile-icon" style="color: var(--primary);">
                        <svg viewBox="0 0 24 24"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" fill="currentColor" /></svg>
                    </div>
                    <div class="profile-text-content no-border">
                        <span class="profile-value">Sync Data</span>
                    </div>
                </div>

                <div class="profile-list-item clickable" @onclick="Logout">
                    <div class="profile-icon" style="color: var(--danger);">
                        <svg viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" fill="currentColor" /></svg>
                    </div>
                    <div class="profile-text-content no-border">
                        <span class="profile-value" style="color: var(--danger);">Log out</span>
                    </div>
                </div>
            </div>

        </div>
        <AppButton Text="Settings"
                   OnClick="Settings" />
    }
</PageContainer>

@code
{
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += ViewModel_PropertyChanged;

        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        await ViewModel.LoadAsync();
    }

    private void ChangePhoto()
    {
        Navigation.NavigateTo("/customer/edit");
    }
    private void Settings()
    {
        Navigation.NavigateTo("/settings");
    }
    private async void ViewModel_PropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }
    private void EditProfile()
    {
        Navigation.NavigateTo("/customer/edit");
    }
    private void Logout()
    {
        SecureStorage.RemoveAll();
        Navigation.NavigateTo("/login");
    }
    public void Dispose()
    {
        ViewModel.PropertyChanged -= ViewModel_PropertyChanged;
    }
}