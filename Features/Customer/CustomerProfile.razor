@page "/customer/profile"


@inject CustomerViewModel ViewModel
@inject NavigationManager Navigation

<PageContainer>

    <AppHeader Title="My Profile" />

    @if (ViewModel.IsBusy)
    {
        <p>Loading profile...</p>
    }
    else if (ViewModel.Customer is null)
    {
        <AppCard>

            <p>Unable to load profile.</p>
            <AppButton Text="Logout"
                       OnClick="Logout" />
            <AppButton Text="Retry"
                       OnClick="LoadProfile" />

        </AppCard>
    }
    else
    {
        <AppCard>
            <ProfileAvatar ImageUrl="@ViewModel.Customer?.ProfilePhotoUrl"
    ShowEditButton="false"
    OnChangePhoto="ChangePhoto" />

            <div class="profile-item">
                <label>Full Name</label>
                <div>@ViewModel.Customer!.FullName</div>
            </div>

            <div class="profile-item">
                <label>Mobile</label>
                <div>@ViewModel.Customer!.MobileNumber</div>
            </div>

            <div class="profile-item">
                <label>Email</label>
                <div>@ViewModel.Customer!.Email</div>
            </div>

            <div class="profile-item">
                <label>Wallet Balance</label>
                <div>₹ @ViewModel.Customer!.WalletBalance</div>
            </div>

            <div class="profile-item">
                <label>Preferred Language</label>
                <div>@ViewModel.Customer!.PreferredLanguage</div>
            </div>

            <div class="profile-item">
                <label>Date of Birth</label>
                <div>@ViewModel.Customer!.DateOfBirth?.ToString("dd MMM yyyy")</div>
            </div>

            <div class="profile-item">
                <label>Gender</label>
                <div>@ViewModel.Customer!.Gender</div>
            </div>

            <div class="profile-item">
                <label>Profile Completed</label>
                <div>@(ViewModel.Customer.IsProfileCompleted ? "Yes" : "No")</div>
            </div>

            <div class="profile-item">
                <label>Referral Code</label>
                <div>@ViewModel.Customer.ReferralCode</div>
            </div>

        </AppCard>
        <AppButton Text="Edit Profile"
                   OnClick="EditProfile" />
        <AppButton Text="Refresh"
                   OnClick="LoadProfile" />
        <AppButton Text="Logout"
                   OnClick="Logout" />
    }

</PageContainer>

@code
{
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += ViewModel_PropertyChanged;

        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        await ViewModel.LoadAsync();
    }

    private void ChangePhoto()
    {
        Navigation.NavigateTo("/customer/edit");
    }

    private async void ViewModel_PropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }
    private void EditProfile()
    {
        Navigation.NavigateTo("/customer/edit");
    }
    private void Logout()
    {
        SecureStorage.RemoveAll();
        Navigation.NavigateTo("/login");
    }
    public void Dispose()
    {
        ViewModel.PropertyChanged -= ViewModel_PropertyChanged;
    }
}