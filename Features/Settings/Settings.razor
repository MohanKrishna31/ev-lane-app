@page "/settings"


@inject SettingsViewModel ViewModel
@inject NavigationManager Navigation

<PageContainer>
    <BackButton />

    <AppCard Title="General">

    <SettingsItem
        Icon="fa fa-language"
        Title="Language"
        Subtitle="@ViewModel.PreferredLanguage"
        OnClick="OpenLanguage" />

</AppCard>

    <AppCard Title="Notifications">

        <AppSwitch Label="Push Notifications"
                   Description="Receive important application notifications."
                   @bind-Value="ViewModel.PushNotificationsEnabled" />

        <AppSwitch Label="Charging Notifications"
                   Description="Charging started, stopped and completed."
                   @bind-Value="ViewModel.ChargingNotificationsEnabled" />

        <AppSwitch Label="Wallet Notifications"
                   Description="Wallet credits, debits and payment updates."
                   @bind-Value="ViewModel.WalletNotificationsEnabled" />

        <AppSwitch Label="Promotional Notifications"
                   Description="Offers, campaigns and announcements."
                   @bind-Value="ViewModel.PromotionalNotificationsEnabled" />

    </AppCard>

    <AppCard Title="Security">

        <AppSwitch Label="Biometric Login"
                   Description="Use fingerprint or Face ID to login."
                   @bind-Value="ViewModel.BiometricLoginEnabled" />

    </AppCard>

    <AppCard Title="Support">

        <SettingsItem Icon="fa fa-shield-alt"
                      Title="Privacy Policy"
                      OnClick="OpenPrivacy" />

        <SettingsItem Icon="fa fa-file-contract"
                      Title="Terms & Conditions"
                      OnClick="OpenTerms" />

        <SettingsItem Icon="fa fa-headset"
                      Title="Contact Us"
                      OnClick="OpenContact" />

        <SettingsItem Icon="fa fa-circle-info"
                      Title="About"
                      OnClick="OpenAbout" />

    </AppCard>
@*     <AppCard Title="Account">

        <SettingsItem Icon="fa fa-trash"
                      Title="Delete Account"
                      Subtitle="Permanently delete your account"
                      OnClick="DeleteAccount" />

    </AppCard> *@
        <AppButton Text="Save Settings" OnClick="SaveSettings" />

</PageContainer>

@code
{
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadAsync();
    }

    private async Task SaveSettings()
    {
        await ViewModel.SaveAsync();
    }

    private void OpenLanguage()
    {

    }

    private void OpenPrivacy()
    {

    }

    private void OpenTerms()
    {

    }

    private void OpenContact()
    {

    }

    private void OpenAbout()
    {

    }
}